# Copy this file to .env in the same folder (university/client).
# Restart `npm start` after changing .env — Create React App loads env only at startup.
#
# Local dev with proxy (package.json → port 5000): leave empty or comment out.
# REACT_APP_API_URL=
#
# Remote or custom API:
REACT_APP_API_URL=https://your-api-server.example.com
